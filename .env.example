# Copy this file to .env and replace the placeholder with your real key.
OPENAI_API_KEY=your_api_key_here

# A cost-efficient default for a basic chatbot. You can use any Responses API model.
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=30

# Sent as the developer instruction on every turn, including continued conversations.
CHATBOT_SYSTEM_PROMPT=You are a helpful, concise assistant.

