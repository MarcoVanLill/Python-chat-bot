# Copy this file to .env and replace the placeholder with your real key.
GEMINI_API_KEY=your_api_key_here

# Reliability controls.
CHATBOT_REQUEST_TIMEOUT_SECONDS=45
CHATBOT_MAX_CONCURRENT_REQUESTS=20
CHATBOT_RETRY_AFTER_SECONDS=30

# Use JSON arrays. Leave empty for non-browser/local usage.
CORS_ALLOWED_ORIGINS=[]
TRUSTED_HOSTS=[]

# Stable Gemini defaults for an interactive chatbot.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RETRY_ATTEMPTS=2
GEMINI_THINKING_LEVEL=low
GEMINI_ENABLE_GOOGLE_SEARCH=false

# Sent as the system instruction on every turn, including continued conversations.
CHATBOT_SYSTEM_PROMPT=You are a helpful, concise assistant.
