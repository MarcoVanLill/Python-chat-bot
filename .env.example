# Copy this file to .env and replace the placeholder with your real key.
GEMINI_API_KEY=your_api_key_here

# Defaults matching the Gemini example supplied for this project.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=1
GEMINI_TOP_P=0.95
GEMINI_THINKING_LEVEL=high
GEMINI_ENABLE_GOOGLE_SEARCH=false

# Sent as the system instruction on every turn, including continued conversations.
CHATBOT_SYSTEM_PROMPT=You are a helpful, concise assistant.
